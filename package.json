{
  "name": "@wirecat/n8n-nodes-wirecat",
  "version": "0.1.0",
  "description": "n8n node for WireCat memo: send leads, deals, people and organizations from any workflow into your own local memory",
  "license": "MIT",
  "homepage": "https://github.com/WireCatLabs/n8n-nodes-wirecat#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "wirecat",
    "memo",
    "mcp",
    "crm",
    "leads"
  ],
  "author": {
    "name": "Viacheslav Ptsarev",
    "email": "leemour@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/n8n-nodes-wirecat.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/WireCatMemoOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WireCatMemo/WireCatMemo.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.4",
    "@types/node": "24.12.0",
    "ajv": "8.17.1",
    "eslint": "9.32.0",
    "n8n-workflow": "2.9.1",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "pnpm@11.28.8"
}
